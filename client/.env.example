# URL of the RaahiGo backend API (see /server).
# Local:       http://localhost:8080
# Production:  your Render URL, e.g. https://raahigo-api.onrender.com   (no trailing slash)
# NOTE: Create React App bakes this in at BUILD time — after changing it on Netlify, trigger a new deploy.
REACT_APP_API_URL=http://localhost:8080

# OPTIONAL. The server already tells the browser which Razorpay key to use (GET /api/payment/config),
# so this is only a fallback. It is the publishable key_id and is safe to expose.
REACT_APP_RAZORPAY_KEY_ID=
