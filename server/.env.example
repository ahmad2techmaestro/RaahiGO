# MongoDB connection string.
# Local MongoDB:        mongodb://127.0.0.1:27017/raahigo
# MongoDB Atlas (free): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/raahigo
MONGODB_URI=mongodb://127.0.0.1:27017/raahigo

# Port the API listens on
PORT=8080

# Secret used to sign JWT auth tokens. Use any long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# The URL your React app runs on, for CORS.
# In production, set this to your deployed frontend URL (e.g. https://raahigo.netlify.app)
CLIENT_ORIGIN=http://localhost:3000

# Payment mode: "demo" = built-in sandbox gateway (no payment account, no real money — great for
# trying the full booking/cashback/refund flow). "razorpay" = real Razorpay. Leave blank to auto-pick:
# razorpay when the keys below are set, demo otherwise.
PAYMENT_MODE=

# Razorpay test keys — get these free from https://dashboard.razorpay.com (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Redis — used for atomic seat locking during checkout.
# OPTIONAL: if omitted, the app still runs and bookings still work, but
# concurrent seat conflicts are only caught by the pre-confirmation check.
# Local:  redis://127.0.0.1:6379
# Hosted: free tiers available from Upstash or Redis Cloud
REDIS_URL=

# How long seats stay held while the user completes checkout (seconds)
SEAT_LOCK_TTL_SECONDS=600

# Secret used to sign ticket QR-verification links. Optional — falls back
# to JWT_SECRET if not set. Set a separate value in production so rotating
# one secret doesn't invalidate the other.
TICKET_VERIFY_SECRET=

# Email notifications (booking confirmations, delays, cancellations, reminders).
# OPTIONAL: without these, notifications are still generated and logged to
# the database (status: SIMULATED) — nothing crashes, no email is actually sent.
# Any real SMTP provider works (Gmail app password, Resend, SendGrid SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Razorpay webhook secret (Dashboard → Settings → Webhooks). Enables the
# payment.failed webhook at POST /webhooks/razorpay. Optional — without it,
# the webhook endpoint acknowledges requests but processes nothing.
RAZORPAY_WEBHOOK_SECRET=

# Set to "false" to disable the background reminder scheduler (useful in
# tests or multi-instance deployments where you only want one instance
# running it).
REMINDER_SCHEDULER_ENABLED=true
